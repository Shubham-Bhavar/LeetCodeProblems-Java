
/*
 * LeetCode 3411: Maximum Subarray With Equal Products
 *
 * Problem:
 * Find the length of the longest subarray where:
 *
 * Product of elements = GCD of elements * LCM of elements.
 *
 * Approach:
 * Brute Force + GCD + LCM.
 *
 * Step-by-Step Explanation:
 * 1. Use an outer loop to select the starting index.
 * 2. Initialize product = 1, gcd = 0, and lcm = 1.
 * 3. Use an inner loop to extend the subarray.
 * 4. Update product by multiplying the current number.
 * 5. Update GCD using the Euclidean algorithm.
 * 6. Update LCM using:
 *      LCM(a, b) = (a / GCD(a, b)) * b
 * 7. Check whether product == gcd * lcm.
 * 8. If true, update the maximum length.
 *
 * Time Complexity: O(n^2 * log(max(nums)))
 * Space Complexity: O(1)
 */

class Solution {

    public int maxLength(int[] nums) {

        int n = nums.length;
        int answer = 0;

        // Select starting index
        for (int i = 0; i < n; i++) {

            int product = 1;
            int gcd = 0;
            int lcm = 1;

            // Extend the subarray
            for (int j = i; j < n; j++) {

                int num = nums[j];

                // Update product
                product *= num;

                // Update GCD
                gcd = findGCD(gcd, num);

                // Update LCM
                lcm = (lcm / findGCD(lcm, num)) * num;

                // Check product equivalent condition
                if (product == gcd * lcm) {

                    answer = Math.max(answer, j - i + 1);
                }
            }
        }

        return answer;
    }

    // Euclidean algorithm to calculate GCD
    private int findGCD(int a, int b) {

        while (b != 0) {

            int temp = b;
            b = a % b;
            a = temp;
        }

        return a;
    }
}
